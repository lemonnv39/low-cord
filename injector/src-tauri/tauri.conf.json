{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "low-cord Injecteur",
  "mainBinaryName": "low-cord-injector",
  "version": "0.1.0",
  "identifier": "io.github.lowcord.injector",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "low-cord Injecteur",
        "width": 760,
        "height": 480,
        "minWidth": 640,
        "minHeight": 420,
        "resizable": true,
        "center": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
