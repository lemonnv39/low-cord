{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "low-cord Injecteur",
  "mainBinaryName": "low-cord-injector",
  "version": "0.3.0",
  "identifier": "io.github.lowcord.injector",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "low-cord Injecteur",
        "width": 860,
        "height": 520,
        "minWidth": 720,
        "minHeight": 460,
        "resizable": true,
        "center": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "shitday",
    "copyright": "© shitday — low-cord, GPL-3.0",
    "shortDescription": "Injecteur low-cord par shitday"
  },
  "plugins": {}
}
